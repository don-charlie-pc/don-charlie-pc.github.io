# PUBLIC: copy ONLY these four values into assets/js/booking-config.js.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_APP_ORIGIN=http://localhost:8000

# PRIVATE: Supabase Edge secrets. Never copy to assets or public/.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://PROJECT.supabase.co/functions/v1/google-calendar-oauth-callback
GOOGLE_CALENDAR_DEFAULT_ID=primary
GOOGLE_TOKEN_ENCRYPTION_KEY_BASE64=
GOOGLE_TOKEN_KEY_VERSION=1
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost
REQUIRE_TURNSTILE=true
ADMIN_APP_ORIGIN=http://localhost:8000
ADMIN_APP_URL=http://localhost:8000/admin/
ALLOWED_ORIGINS=http://localhost:8000
BUSINESS_TIMEZONE=America/Mexico_City
RATE_LIMIT_SALT=
# Gateway-controlled client IP header; verify for your deployed ingress.
CLIENT_IP_HEADER=x-forwarded-for
